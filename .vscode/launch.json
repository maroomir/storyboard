{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/desktop"],
      "outFiles": ["${workspaceFolder}/apps/desktop/out/**/*.js"],
      "preLaunchTask": "storybook: compile"
    }
  ]
}