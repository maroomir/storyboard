{
  "name": "storyboard-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace storyboard",
    "compile": "npm run compile --workspace storyboard",
    "lint": "npm run lint --workspace storyboard && npm run lint --workspace @storyboard/bot",
    "test": "npm run test --workspace storyboard && npm run test --workspace @storyboard/bot",
    "package:vsix": "npm run package:vsix --workspace storyboard",
    "bot:build": "npm run build --workspace @storyboard/bot",
    "bot:start": "npm run start --workspace @storyboard/bot"
  }
}
