{
  "name": "storyboard",
  "displayName": "Storyboard",
  "description": "AI-powered fiction IDE for writing novels and screenplays in VSCode.",
  "version": "0.2.4",
  "publisher": "maroomir",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/maroomir/storyboard.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.storyboard/project.json",
    "onCommand:storyboard.seed.createFromFile",
    "onCommand:storyboard.seed.syncFromFile",
    "onCommand:storyboard.seed.exportToFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "storyboard.helloWorld",
        "title": "Storyboard: Hello World"
      },
      {
        "command": "storyboard.init",
        "title": "Storyboard: Initialize Project"
      },
      {
        "command": "storyboard.seed.createFromFile",
        "title": "Storyboard: Create Project from Seed..."
      },
      {
        "command": "storyboard.seed.syncFromFile",
        "title": "Storyboard: Sync Project from Seed..."
      },
      {
        "command": "storyboard.seed.exportToFile",
        "title": "Storyboard: Export Project to Seed..."
      },
      {
        "command": "storyboard.character.create",
        "title": "Storyboard: Create Character",
        "icon": "$(add)"
      },
      {
        "command": "storyboard.background.create",
        "title": "Storyboard: Create Background",
        "icon": "$(add)"
      },
      {
        "command": "storyboard.character.rename",
        "title": "Storyboard: Rename Character ID..."
      },
      {
        "command": "storyboard.background.rename",
        "title": "Storyboard: Rename Background ID..."
      },
      {
        "command": "storyboard.apiKey.set",
        "title": "Storyboard: Set API Key..."
      },
      {
        "command": "storyboard.draft.generate",
        "title": "Storyboard: Generate Draft (Current Scene)"
      },
      {
        "command": "storyboard.draft.regenerate",
        "title": "Storyboard: Regenerate Draft (Current Scene)"
      },
      {
        "command": "storyboard.draft.generateAll",
        "title": "Storyboard: Generate All Drafts"
      },
      {
        "command": "storyboard.outline.generate",
        "title": "Storyboard: Generate Novel Outline"
      },
      {
        "command": "storyboard.scene.generateAllSeeds",
        "title": "Storyboard: Generate Scene Seeds"
      },
      {
        "command": "storyboard.draft.applyFormat",
        "title": "Storyboard: Apply Format to Draft (Current Scene)"
      },
      {
        "command": "storyboard.scene.create",
        "title": "Storyboard: New Scene",
        "icon": "$(add)"
      },
      {
        "command": "storyboard.scene.openDraft",
        "title": "Storyboard: Open Draft for Scene"
      },
      {
        "command": "storyboard.relationGraph.open",
        "title": "Storyboard: Open Character Relation Graph"
      },
      {
        "command": "storyboard.settings.open",
        "title": "Storyboard: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "storyboard.draft.grammarCheck",
        "title": "Storyboard: Grammar Check (Draft)"
      },
      {
        "command": "storyboard.draft.continuityCheck",
        "title": "Storyboard: Continuity Check (Draft)"
      },
      {
        "command": "storyboard.draft.reviseLoop",
        "title": "Storyboard: Review & Revise Draft (Current Scene)"
      },
      {
        "command": "storyboard.bible.promoteCandidates",
        "title": "Storyboard: Promote Bible Candidates to Canon"
      },
      {
        "command": "storyboard.draft.expand",
        "title": "Storyboard: Expand Selection (Draft)"
      }
    ],
    "configuration": {
      "title": "Storyboard",
      "properties": {
        "storyboard.defaultProvider": {
          "type": "string",
          "enum": [
            "openai",
            "claude",
            "google",
            "ollama",
            "mock"
          ],
          "default": "mock",
          "description": "Default AI provider used when a task does not override the provider."
        },
        "storyboard.providers.openai.model": {
          "type": "string",
          "default": "gpt-5.4-mini",
          "description": "OpenAI model used by Storyboard."
        },
        "storyboard.providers.claude.model": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Claude model used by Storyboard."
        },
        "storyboard.providers.google.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Google Gemini model used by Storyboard."
        },
        "storyboard.providers.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the local Ollama server."
        },
        "storyboard.providers.ollama.model": {
          "type": "string",
          "default": "llama3.3",
          "description": "Ollama model used by Storyboard."
        },
        "storyboard.tasks": {
          "type": "object",
          "default": {},
          "description": "Per-task AI provider and optional model overrides. Example: { \"personaGeneration\": { \"provider\": \"claude\" }, \"sceneDraft\": { \"provider\": \"claude\", \"model\": \"claude-sonnet-4-6\" } }. Model IDs must match the Storyboard catalog for that provider.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "claude",
                  "google",
                  "ollama",
                  "mock"
                ]
              },
              "model": {
                "type": "string",
                "description": "Catalog model id for this task. When omitted, the provider’s global model setting is used."
              }
            },
            "additionalProperties": false
          }
        },
        "storyboard.grammar.realtimeEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable real-time grammar diagnostics. Disabled by default for performance."
        },
        "storyboard.ai.contextCondenseEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable lightweight previous-context condense for long scene generation prompts."
        },
        "storyboard.scene.prefixDigits": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Number of zero-padded digits used for new scene file prefixes."
        },
        "storyboard.draft.reviseMaxIterations": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum number of revision passes in the Review & Revise Draft loop."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "storyboard.card",
        "displayName": "Storyboard Card",
        "selector": [
          {
            "filenamePattern": "*.card"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "storyboard-characters",
          "title": "Storyboard · Characters",
          "icon": "assets/activity-characters.svg"
        },
        {
          "id": "storyboard-backgrounds",
          "title": "Storyboard · Backgrounds",
          "icon": "assets/activity-backgrounds.svg"
        },
        {
          "id": "storyboard-scenes",
          "title": "Storyboard · Scenes",
          "icon": "assets/activity-scenes.svg"
        }
      ]
    },
    "views": {
      "storyboard-characters": [
        {
          "id": "storyboard.charactersView",
          "name": "Characters",
          "type": "webview",
          "when": "storyboard.workspaceReady"
        }
      ],
      "storyboard-backgrounds": [
        {
          "id": "storyboard.backgroundsView",
          "name": "Backgrounds",
          "type": "webview",
          "when": "storyboard.workspaceReady"
        }
      ],
      "storyboard-scenes": [
        {
          "id": "storyboard.scenesView",
          "name": "Scenes",
          "type": "webview",
          "when": "storyboard.workspaceReady"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "storyboard.seed.syncFromFile",
          "when": "resourceExtname == .seed",
          "group": "storyboard@98"
        },
        {
          "command": "storyboard.character.rename",
          "when": "resourceExtname == .card && resourceFilename != .sample.card",
          "group": "storyboard@1"
        },
        {
          "command": "storyboard.background.rename",
          "when": "resourceExtname == .card && resourceFilename != .sample.card",
          "group": "storyboard@1"
        }
      ],
      "view/title": [
        {
          "command": "storyboard.character.create",
          "when": "view == storyboard.charactersView",
          "group": "navigation"
        },
        {
          "command": "storyboard.background.create",
          "when": "view == storyboard.backgroundsView",
          "group": "navigation"
        },
        {
          "command": "storyboard.scene.create",
          "when": "view == storyboard.scenesView",
          "group": "navigation"
        },
        {
          "command": "storyboard.settings.open",
          "when": "view == storyboard.charactersView",
          "group": "navigation@99"
        },
        {
          "command": "storyboard.settings.open",
          "when": "view == storyboard.backgroundsView",
          "group": "navigation@99"
        },
        {
          "command": "storyboard.settings.open",
          "when": "view == storyboard.scenesView",
          "group": "navigation@99"
        }
      ],
      "view/item/context": [
        {
          "command": "storyboard.character.rename",
          "when": "view == storyboard.charactersView",
          "group": "inline"
        },
        {
          "command": "storyboard.background.rename",
          "when": "view == storyboard.backgroundsView",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "build": "npm run compile && npm run build:webview",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint . --ext .ts && tsc --project webview-ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "package": "npm run package:vsix",
    "package:vsix": "mkdir -p dist && npm run build && vsce package"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/vsce": "^3.9.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.13",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@fontsource-variable/cormorant-garamond": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/generative-ai": "^0.24.1",
    "@seedcoat/wasm": "file:vendor/seedcoat-wasm-0.4.0.tgz",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "framer-motion": "^11.18.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.468.0",
    "openai": "^6.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.2"
  }
}
