{
  "name": "storyboard",
  "displayName": "Storyboard",
  "description": "AI-powered fiction IDE for writing novels and screenplays in VSCode.",
  "version": "0.0.1",
  "publisher": "maroomir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/maroomir/storyboard.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:storyboard.helloWorld",
    "onCommand:storyboard.init",
    "onView:storyboard.sidebar",
    "workspaceContains:.storyboard/project.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "storyboard.helloWorld",
        "title": "Storyboard: Hello World"
      },
      {
        "command": "storyboard.init",
        "title": "Storyboard: Initialize Project"
      }
    ],
    "customEditors": [
      {
        "viewType": "storyboard.card",
        "displayName": "Storyboard Card",
        "selector": [
          {
            "filenamePattern": "*.card"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "storyboard",
          "title": "Storyboard",
          "icon": "assets/storyboard.svg"
        }
      ]
    },
    "views": {
      "storyboard": [
        {
          "id": "storyboard.sidebar",
          "name": "Storyboard",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "build": "npm run compile && npm run build:webview",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint . --ext .ts && tsc --project webview-ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "package": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/js-yaml": "^4.0.9",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.2"
  }
}
