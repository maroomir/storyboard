{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "sourceMap": true,
    "types": [
      "node",
      "vscode"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@webview/*": [
        "webview-ui/src/*"
      ],
      "@storyboard/story-engine": [
        "../../packages/story-engine/src/index.ts"
      ],
      "@storyboard/story-format": [
        "../../packages/story-format/src/index.ts"
      ],
      "@storyboard/story-config": [
        "../../packages/story-config/src/index.ts"
      ],
      "@storyboard/story-ai": [
        "../../packages/story-ai/src/index.ts"
      ],
      "@storyboard/story-pipeline": [
        "../../packages/story-pipeline/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
