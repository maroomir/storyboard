{
  "name": "storyboard-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.8.0",
  "publisher": "maroomir",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/maroomir/storyboard.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.storyboard/project.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "storyboard.init",
        "title": "%storyboard.init.title%"
      },
      {
        "command": "storyboard.character.create",
        "title": "%storyboard.character.create.title%",
        "icon": "$(add)"
      },
      {
        "command": "storyboard.background.create",
        "title": "%storyboard.background.create.title%",
        "icon": "$(add)"
      },
      {
        "command": "storyboard.character.recommend",
        "title": "%storyboard.character.recommend.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "storyboard.background.recommend",
        "title": "%storyboard.background.recommend.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "storyboard.cards.buildFromScenes",
        "title": "%storyboard.cards.buildFromScenes.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "storyboard.character.rename",
        "title": "%storyboard.character.rename.title%"
      },
      {
        "command": "storyboard.background.rename",
        "title": "%storyboard.background.rename.title%"
      },
      {
        "command": "storyboard.apiKey.set",
        "title": "%storyboard.apiKey.set.title%"
      },
      {
        "command": "storyboard.draft.generate",
        "title": "%storyboard.draft.generate.title%"
      },
      {
        "command": "storyboard.draft.regenerate",
        "title": "%storyboard.draft.regenerate.title%"
      },
      {
        "command": "storyboard.draft.generateAll",
        "title": "%storyboard.draft.generateAll.title%"
      },
      {
        "command": "storyboard.novel.generate",
        "title": "%storyboard.novel.generate.title%"
      },
      {
        "command": "storyboard.outline.generate",
        "title": "%storyboard.outline.generate.title%"
      },
      {
        "command": "storyboard.scene.generateAllSeeds",
        "title": "%storyboard.scene.generateAllSeeds.title%"
      },
      {
        "command": "storyboard.scene.completeStory",
        "title": "%storyboard.scene.completeStory.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "storyboard.manuscript.assemble",
        "title": "%storyboard.manuscript.assemble.title%"
      },
      {
        "command": "storyboard.manuscript.review",
        "title": "%storyboard.manuscript.review.title%"
      },
      {
        "command": "storyboard.manuscript.summaries",
        "title": "%storyboard.manuscript.summaries.title%"
      },
      {
        "command": "storyboard.draft.applyFormat",
        "title": "%storyboard.draft.applyFormat.title%"
      },
      {
        "command": "storyboard.scene.migrate",
        "title": "%storyboard.scene.migrate.title%"
      },
      {
        "command": "storyboard.scene.create",
        "title": "%storyboard.scene.create.title%",
        "icon": "$(add)"
      },
      {
        "command": "storyboard.scene.openDraft",
        "title": "%storyboard.scene.openDraft.title%"
      },
      {
        "command": "storyboard.relationGraph.open",
        "title": "%storyboard.relationGraph.open.title%"
      },
      {
        "command": "storyboard.settings.open",
        "title": "%storyboard.settings.open.title%",
        "icon": "$(gear)"
      },
      {
        "command": "storyboard.draft.grammarCheck",
        "title": "%storyboard.draft.grammarCheck.title%"
      },
      {
        "command": "storyboard.draft.continuityCheck",
        "title": "%storyboard.draft.continuityCheck.title%"
      },
      {
        "command": "storyboard.draft.slopCheck",
        "title": "%storyboard.draft.slopCheck.title%"
      },
      {
        "command": "storyboard.draft.reviseLoop",
        "title": "%storyboard.draft.reviseLoop.title%"
      },
      {
        "command": "storyboard.draft.condense",
        "title": "%storyboard.draft.condense.title%"
      },
      {
        "command": "storyboard.bible.promoteCandidates",
        "title": "%storyboard.bible.promoteCandidates.title%"
      },
      {
        "command": "storyboard.cards.promoteCandidates",
        "title": "%storyboard.cards.promoteCandidates.title%"
      },
      {
        "command": "storyboard.cards.migrateTextToList",
        "title": "%storyboard.cards.migrateTextToList.title%"
      },
      {
        "command": "storyboard.bible.canonDiff",
        "title": "%storyboard.bible.canonDiff.title%"
      },
      {
        "command": "storyboard.draft.expand",
        "title": "%storyboard.draft.expand.title%"
      },
      {
        "command": "storyboard.draft.augment",
        "title": "%storyboard.draft.augment.title%"
      },
      {
        "command": "storyboard.draft.augmentSelection",
        "title": "%storyboard.draft.augmentSelection.title%"
      },
      {
        "command": "storyboard.draft.editSelection",
        "title": "%storyboard.draft.editSelection.title%"
      },
      {
        "command": "storyboard.draft.export",
        "title": "%storyboard.draft.export.title%"
      }
    ],
    "configuration": {
      "title": "Storyboard",
      "properties": {
        "storyboard.defaultProvider": {
          "type": "string",
          "enum": [
            "openai",
            "claude",
            "google",
            "ollama",
            "claude-code",
            "codex",
            "mock"
          ],
          "default": "mock",
          "description": "Default AI provider used when a task does not override the provider."
        },
        "storyboard.providers.openai.model": {
          "type": "string",
          "default": "gpt-5.4-mini",
          "description": "OpenAI model used by Storyboard."
        },
        "storyboard.providers.claude.model": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Claude model used by Storyboard."
        },
        "storyboard.providers.google.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Google Gemini model used by Storyboard."
        },
        "storyboard.providers.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the local Ollama server."
        },
        "storyboard.providers.ollama.model": {
          "type": "string",
          "default": "llama3.3",
          "description": "Ollama model used by Storyboard."
        },
        "storyboard.providers.claude-code.command": {
          "type": "string",
          "default": "claude",
          "description": "Executable used to invoke the Claude Code CLI. Override with an absolute path if it is not on PATH."
        },
        "storyboard.providers.claude-code.model": {
          "type": "string",
          "default": "sonnet",
          "description": "Model passed to the Claude Code CLI (e.g. sonnet, opus, haiku). Uses your Claude Code login; no API key required."
        },
        "storyboard.providers.claude-code.timeoutMs": {
          "type": "integer",
          "default": 600000,
          "minimum": 60000,
          "maximum": 1800000,
          "description": "Per-call timeout (ms) for the Claude Code CLI. Long reasoning beats can exceed the previous 180s; default 600000 (10 min)."
        },
        "storyboard.providers.codex.command": {
          "type": "string",
          "default": "codex",
          "description": "Executable used to invoke the Codex CLI. Override with an absolute path if it is not on PATH."
        },
        "storyboard.providers.codex.model": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "Model passed to the Codex CLI. Uses your Codex login; no API key required."
        },
        "storyboard.providers.codex.timeoutMs": {
          "type": "integer",
          "default": 600000,
          "minimum": 60000,
          "maximum": 1800000,
          "description": "Per-call timeout (ms) for the Codex CLI. Long reasoning beats can exceed the previous 180s; default 600000 (10 min)."
        },
        "storyboard.providers.codex.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "minimal",
            "low",
            "medium",
            "high"
          ],
          "default": "",
          "description": "Reasoning effort passed to the Codex CLI as model_reasoning_effort. Empty uses the CLI default."
        },
        "storyboard.tasks": {
          "type": "object",
          "default": {},
          "description": "Per-task AI provider and optional model overrides. Example: { \"personaGeneration\": { \"provider\": \"claude\" }, \"sceneDraft\": { \"provider\": \"claude\", \"model\": \"claude-sonnet-4-6\" } }. Model IDs must match the Storyboard catalog for that provider.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "claude",
                  "google",
                  "ollama",
                  "claude-code",
                  "codex",
                  "mock"
                ]
              },
              "model": {
                "type": "string",
                "description": "Catalog model id for this task. When omitted, the provider’s global model setting is used."
              }
            },
            "additionalProperties": false
          }
        },
        "storyboard.grammar.realtimeEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable real-time grammar diagnostics. Disabled by default for performance."
        },
        "storyboard.slop.realtimeEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable on-save slop / AI-tell diagnostics for drafts. Disabled by default."
        },
        "storyboard.ai.contextCondenseEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable lightweight previous-context condense for long scene generation prompts."
        },
        "storyboard.scene.prefixDigits": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Number of zero-padded digits used for new scene file prefixes."
        },
        "storyboard.draft.reviseMaxIterations": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum number of revision passes in the Review & Revise Draft loop."
        },
        "storyboard.draft.reviseAfterGenerate": {
          "type": "boolean",
          "default": true,
          "description": "After generating a draft (Generate Draft / Regenerate Draft / Generate All Drafts), automatically run the continuity & critique revise gate so one action produces a reviewed draft. On by default for quality; turn off to skip the extra AI calls and cost per draft."
        },
        "storyboard.draft.reviseScoreThreshold": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 100,
          "description": "Optional critique-score quality bar (0–100) that lets the Review & Revise loop pass early once the deterministic rubric score reaches it. 0 disables this and keeps the loop's stop behavior and AI-call count identical to before. High-severity continuity issues still block regardless."
        },
        "storyboard.draft.maxCompressionPercent": {
          "type": "integer",
          "default": 50,
          "minimum": 0,
          "maximum": 90,
          "description": "Maximum percentage a reviewed or manually condensed draft may be shortened. 50 keeps at least half of the original draft when no scene target length is set."
        },
        "storyboard.draft.updateCardsAfterGenerate": {
          "type": "boolean",
          "default": false,
          "description": "After generating a draft, feed the result back into cards: traits and recent dialogue are written to character cards, detected characters are added to the scene's background card, and relation/arc/attribute candidates are extracted for review via 'Promote Card Candidates'. Off by default to keep cards stable; enabling it adds extraction model calls per generation."
        },
        "storyboard.draft.verifyCardCandidates": {
          "type": "boolean",
          "default": true,
          "description": "When 'Update cards after generate' is on, re-check each extracted relation/arc/attribute candidate against the draft body and keep only the ones explicitly stated, reducing hallucinated candidates before they reach 'Promote Card Candidates'. Adds one verification model call per detected character; turn off to skip it."
        },
        "storyboard.grounding.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Before generating a draft, Storyboard fills any missing scene grounding facts (incident, place, relation, time) and stores them in the scene frontmatter. Off by default, so the proposal is shown for review first; turn on to accept proposals automatically and keep generation one-click."
        },
        "storyboard.studio.validation": {
          "type": "boolean",
          "default": true,
          "description": "Before showing a Studio chat proposal, run an extra AI pass that checks it against the related cards and scenes and flags conflicts. Turn off to skip that pass and save a request per proposal."
        },
        "storyboard.draft.keepHistory": {
          "type": "boolean",
          "default": false,
          "description": "Before a draft is overwritten by Generate/Regenerate, archive the previous version under '.draft/<scene>/<yyyy-mm-dd-hh-mm>-rev-NN.md' so older drafts accumulate as history. Off by default; the '.draft' folder is gitignored like 'draft'."
        },
        "storyboard.draft.sceneBreakEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Insert a scene-break separator between generated scene beats in a draft. When enabled, genre formatting runs once per beat, so AI formatting calls grow with the beat count."
        },
        "storyboard.draft.sceneBreakSeparator": {
          "type": "string",
          "default": "---",
          "description": "Separator inserted between scene beats when the scene break is enabled. Enter separator text such as --- for a horizontal rule, or a number from 1 to 10 to insert that many newlines instead."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "storyboard.card",
        "displayName": "Storyboard Card",
        "selector": [
          {
            "filenamePattern": "*.card"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "storyboard-characters",
          "title": "Storyboard · Characters",
          "icon": "assets/activity-characters.svg"
        },
        {
          "id": "storyboard-backgrounds",
          "title": "Storyboard · Backgrounds",
          "icon": "assets/activity-backgrounds.svg"
        },
        {
          "id": "storyboard-scenes",
          "title": "Storyboard · Scenes",
          "icon": "assets/activity-scenes.svg"
        },
        {
          "id": "storyboard-studio",
          "title": "Storyboard · Studio",
          "icon": "assets/activity-studio.svg"
        }
      ]
    },
    "views": {
      "storyboard-characters": [
        {
          "id": "storyboard.charactersView",
          "name": "Characters",
          "type": "webview",
          "when": "storyboard.workspaceReady"
        }
      ],
      "storyboard-backgrounds": [
        {
          "id": "storyboard.backgroundsView",
          "name": "Backgrounds",
          "type": "webview",
          "when": "storyboard.workspaceReady"
        }
      ],
      "storyboard-scenes": [
        {
          "id": "storyboard.scenesView",
          "name": "Scenes",
          "type": "webview",
          "when": "storyboard.workspaceReady"
        }
      ],
      "storyboard-studio": [
        {
          "id": "storyboard.studioView",
          "name": "Studio",
          "type": "webview",
          "when": "storyboard.workspaceReady"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "storyboard.character.rename",
          "when": "resourceExtname == .card && resourceFilename != .sample.card",
          "group": "storyboard@1"
        },
        {
          "command": "storyboard.background.rename",
          "when": "resourceExtname == .card && resourceFilename != .sample.card",
          "group": "storyboard@1"
        }
      ],
      "view/title": [
        {
          "command": "storyboard.character.create",
          "when": "view == storyboard.charactersView",
          "group": "navigation"
        },
        {
          "command": "storyboard.background.create",
          "when": "view == storyboard.backgroundsView",
          "group": "navigation"
        },
        {
          "command": "storyboard.character.recommend",
          "when": "view == storyboard.charactersView",
          "group": "navigation@1"
        },
        {
          "command": "storyboard.background.recommend",
          "when": "view == storyboard.backgroundsView",
          "group": "navigation@1"
        },
        {
          "command": "storyboard.cards.buildFromScenes",
          "when": "view == storyboard.charactersView || view == storyboard.backgroundsView",
          "group": "navigation@2"
        },
        {
          "command": "storyboard.scene.create",
          "when": "view == storyboard.scenesView",
          "group": "navigation"
        },
        {
          "command": "storyboard.scene.completeStory",
          "when": "view == storyboard.scenesView",
          "group": "navigation@1"
        },
        {
          "command": "storyboard.settings.open",
          "when": "view == storyboard.charactersView",
          "group": "navigation@99"
        },
        {
          "command": "storyboard.settings.open",
          "when": "view == storyboard.backgroundsView",
          "group": "navigation@99"
        },
        {
          "command": "storyboard.settings.open",
          "when": "view == storyboard.scenesView",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "build": "npm run compile && npm run build:webview",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint . --ext .ts && tsc --noEmit -p tsconfig.json && tsc --project webview-ui/tsconfig.json --noEmit && npm run check:architecture && npm run format:check:src",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check:src": "prettier --check src",
    "package:vsix": "mkdir -p dist && npm run build && vsce package --no-dependencies --baseContentUrl https://github.com/maroomir/storyboard/blob/HEAD/apps/vscode/"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/vsce": "^3.9.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.13",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@storyboard/story-ai": "*",
    "@storyboard/story-engine": "*",
    "@storyboard/story-format": "*",
    "@storyboard/story-pipeline": "*",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "framer-motion": "^11.18.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.2"
  }
}
