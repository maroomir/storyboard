{
  "name": "@storyboard/cli",
  "version": "0.8.0",
  "private": true,
  "description": "Storyboard on the command line: plan, draft, review and assemble a novel from a terminal or an AI agent",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "bin": { "storyboard": "dist/index.js" },
  "scripts": {
    "build": "rm -rf dist && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" && npm run typecheck && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@storyboard/story-ai": "*",
    "@storyboard/story-engine": "*",
    "@storyboard/story-format": "*",
    "@storyboard/story-pipeline": "*",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
