{
  "name": "@storyboard/cli",
  "version": "0.12.4",
  "private": true,
  "description": "Storyboard on the command line: plan, draft, review and assemble a novel from a terminal or an AI agent",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.mjs",
  "bin": {
    "storyboard": "dist/index.mjs"
  },
  "scripts": {
    "build": "rm -rf dist && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && npm run typecheck && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@storyboard/story-ai": "*",
    "@storyboard/story-app": "*",
    "@storyboard/story-config": "*",
    "@storyboard/story-engine": "*",
    "@storyboard/story-model": "*",
    "@storyboard/story-node": "*",
    "@storyboard/story-sim": "*",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "wrap-ansi": "^9.0.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
