{
  "name": "@storyboard/desktop",
  "productName": "Storyboard",
  "version": "0.11.4",
  "private": true,
  "description": "Storyboard for writers: a desktop app that plans, drafts, reviews and assembles a novel",
  "author": "Maroomir Yoon <maroomir@gmail.com>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && node esbuild.config.mjs && vite build",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && npm run typecheck && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --publish never --mac",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --publish never --win"
  },
  "dependencies": {
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@storyboard/story-ai": "*",
    "@storyboard/story-app": "*",
    "@storyboard/story-config": "*",
    "@storyboard/story-engine": "*",
    "@storyboard/story-model": "*",
    "@storyboard/story-node": "*",
    "electron-updater": "^6.8.9",
    "isomorphic-git": "^1.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
