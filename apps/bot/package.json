{
  "name": "storygram",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram companion for the Storyboard fiction IDE: edits the same git workspace as the VSCode extension",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "storygram": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" && npm run typecheck && npm run check:architecture",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "schema:emit": "UPDATE_CONFIG_SCHEMA=1 vitest run test/configSchemaFile.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@storyboard/story-ai": "*",
    "@seedkernel/wasm": "file:../../vendor/seedkernel-wasm-0.1.1.tgz",
    "@storyboard/story-git": "*",
    "@storyboard/story-pipeline": "*",
    "better-sqlite3": "^11.8.1",
    "grammy": "^1.30.0",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
