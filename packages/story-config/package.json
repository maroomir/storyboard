{
  "name": "@storyboard/story-config",
  "version": "0.0.0",
  "private": true,
  "description": "The shared Storyboard home (~/.storyboard): config layers, the secrets file, and their watchers",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "imports": {
    "#config/*": "./src/*.ts"
  },
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@storyboard/story-ai": "*"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck"
  }
}
