{
  "name": "@storyboard/story-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Storyboard's runtime-agnostic core: domain policies, file records, and the shared contracts every app speaks",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "imports": {
    "#engine/*": "./src/*.ts"
  },
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/shared/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "eslint \"src/**/*.ts\" && npm run typecheck && npm run check:architecture"
  },
  "dependencies": {
    "@storyboard/story-ai": "*",
    "@storyboard/story-format": "*",
    "@storyboard/story-pipeline": "*",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.6.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8.57.1"
  }
}
